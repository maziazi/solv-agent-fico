# Solv environment template (docs/SPEC.md §5, README "Development").
# Copy to .env and fill in. .env is gitignored; keys never enter the repo,
# issues, or PR descriptions (AGENTS.md hard prohibitions).

# Tier 1 — Cloudflare Workers AI, Clef-flash.
# Dashboard -> AI -> Workers AI; token needs Workers AI read/run permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Tier 2 — OpenServ SERV Reasoning (console.openserv.ai).
SERV_API_KEY=

# Tier 3 — Reppo Evaluation API (eval.reppo.xyz -> API Key).
REPPO_API_KEY=

# Service (optional).
PORT=8080
STATE_FILE=solv_state.json
